# 复制为 .env 后按院内实际地址填写；本文件不含任何真实凭据。
# 所有凭据一律从环境变量读取，程序内不硬编码、不落盘。

# ---- 出站写：院内卫健上报网关 ----
# POST {REGULATORY_REPORT_BASE_URL}/api/v1/regulatory-submissions
REGULATORY_REPORT_BASE_URL=https://regulatory-gateway.internal.example
# Authorization: Bearer <token>
REGULATORY_REPORT_TOKEN=
# 出站写超时（秒，可选；缺省 30）
REGULATORY_REPORT_TIMEOUT_SECS=30

# ---- 出站读：HIS 科室主数据目录 ----
# GET {HIS_BASE_URL}/api/v1/dept-directory
# 不填也能跑：那时科室维度标「科室主数据未校验」（这轮没查），不静默通过
HIS_BASE_URL=https://his.internal.example
# Authorization: Bearer <token>
HIS_API_TOKEN=
# 目录调用超时（秒，可选；缺省 10）
HIS_TIMEOUT_SECS=10

# ---- 模型端点（仅用于重复项语义归并与差异说明草稿；不可达时主路径仍可跑）----
# OpenAI 兼容协议：base_url / api_key / model / timeout 四项全环境变量化
OPENAI_BASE_URL=https://model-gateway.internal.example/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECS=20

# ---- 本机状态（引擎读写；单文件 SQLite）----
# 校验库文件路径：行列级结论、确认记录、回执、审计链
REGVAL_STATE_DB=./.regval/state.db
# 口径规则目录：版本化规则表 + 27 项指标口径种子
REGVAL_RULE_DIR=./rules

# ---- 可选调参 ----
# 重复检测第 3 级（编辑距离）的字符距离阈值
REGVAL_DUP_DISTANCE_THRESHOLD=2
# 重复检测第 3 级：两行指标名称的长度差上限（超过则跳过该行对并计数）
REGVAL_DUP_MAX_LENGTH_GAP=40
# 科室主数据目录缓存的有效期（秒，可选；缺省 3600）：拉取失败时用上次缓存，超过则标「已超过有效期」
REGVAL_DEPT_DIRECTORY_TTL_SECS=3600

# ---- 上报退避重试（网关临时不可用时用；4xx 退回一律不重试）----
# 总尝试次数（含第一次；1 = 不重试；可选；缺省 3）
REGVAL_PUSH_RETRY_MAX_ATTEMPTS=3
# 退避基数（毫秒；第一次重试等多久；可选；缺省 500）
REGVAL_PUSH_RETRY_BASE_MS=500
# 单次退避上限（毫秒；可选；缺省 5000）
REGVAL_PUSH_RETRY_MAX_DELAY_MS=5000

# ---- 日志 ----
# 结构化 JSON 行日志的等级门槛：debug / info / warn / error
REGVAL_LOG_LEVEL=info
